# Configurações da Studio Kustom Engine (KustomCraft)
ENV=development
DPI_DEFAULT=300

# Caminhos do Chão de Fábrica (relativos ou parametrizados via ambiente)
STUDIO_KUSTOM_DATA_DIR="D:/Desktop/Studio Kustom"
OUTPUT_DIR="./data/output"
TEMP_DIR="./data/temp"

# Banco de Dados SQLite Local
DB_PATH="./database/kustomcraft.db"

# API Keys (quando integradas nas fases seguintes)
GEMINI_API_KEY=""
SHOPEE_PARTNER_ID=""
SHOPEE_PARTNER_KEY=""
